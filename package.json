{
  "name": "aws-internal-lab",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test tests/unit/bootstrap.test.ts tests/unit/aws-virtual.test.ts tests/unit/auth.test.ts tests/unit/control-plane-server.test.ts",
    "lint": "eslint apps packages tests scripts",
    "check": "pnpm lint && pnpm boundaries && pnpm typecheck && pnpm test && pnpm build && pnpm build:web",
    "boundaries": "node scripts/check-boundaries.mjs",
    "dev:control-plane": "tsx apps/control-plane/src/server.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "test:integration:db": "node --import tsx --test tests/integration/db.test.ts tests/integration/workspace.test.ts",
    "build:web": "pnpm --filter @aws-internal-lab/web build"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/node": "^24.3.0",
    "eslint": "^9.35.0",
    "globals": "^16.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0"
  },
  "packageManager": "pnpm@10.17.1",
  "dependencies": {
    "postgres": "^3.4.7"
  }
}
